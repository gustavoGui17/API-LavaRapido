{
  "openapi": "3.0.0",
  "info": {
    "title": "API Lava Rápido",
    "version": "1.0.0",
    "description": "Documentação da API do sistema de lava rápido",
    "contact": {
      "email": "gustavo.gsilva1723@gmail.com"
    }
  },
  "servers": [
    {
      "url": "https://api-lavarapido.onrender.com",
      "description": "Servidor Render"
    },
    {
      "url": "http://localhost:3000",
      "description": "Servidor local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "cliente",
              "consumidor"
            ]
          },
          "telefone": {
            "type": "string"
          },
          "endereco": {
            "$ref": "#/components/schemas/Endereco"
          },
          "location": {
            "$ref": "#/components/schemas/GeoPoint"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "Veiculo": {
        "type": "object",
        "properties": {
          "placa": {
            "type": "string"
          },
          "modelo": {
            "type": "string"
          },
          "cor": {
            "type": "string"
          },
          "tipoLavagem": {
            "type": "string",
            "enum": [
              "simples",
              "completa",
              "premium"
            ]
          },
          "nomeCliente": {
            "type": "string"
          },
          "contato": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pendente",
              "em atendimento",
              "finalizado"
            ]
          }
        },
        "required": [
          "placa",
          "modelo",
          "cor",
          "tipoLavagem",
          "nomeCliente",
          "contato"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Customer": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "nomeFantasia": {
            "type": "string"
          },
          "documento": {
            "type": "string"
          },
          "documentoTipo": {
            "type": "string",
            "enum": [
              "cpf",
              "cnpj"
            ]
          },
          "contato": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ativo",
              "inativo"
            ]
          },
          "endereco": {
            "$ref": "#/components/schemas/Endereco"
          },
          "location": {
            "$ref": "#/components/schemas/GeoPoint"
          },
          "diasFuncionamento": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Dias da semana (0 = domingo, 6 = sábado)"
          }
        },
        "required": [
          "nome",
          "documento",
          "documentoTipo",
          "contato"
        ]
      },
      "Endereco": {
        "type": "object",
        "properties": {
          "cep": {
            "type": "string"
          },
          "logradouro": {
            "type": "string"
          },
          "numero": {
            "type": "string"
          },
          "bairro": {
            "type": "string"
          },
          "cidade": {
            "type": "string"
          },
          "estado": {
            "type": "string"
          }
        }
      },
      "GeoPoint": {
        "type": "object",
        "description": "Localização GeoJSON. coordinates = [longitude, latitude]",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Point"
            ]
          },
          "coordinates": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "VeiculoCliente": {
        "type": "object",
        "properties": {
          "placa": {
            "type": "string"
          },
          "modelo": {
            "type": "string"
          },
          "cor": {
            "type": "string"
          },
          "ano": {
            "type": "integer"
          }
        },
        "required": [
          "placa",
          "modelo",
          "cor"
        ]
      },
      "Agendamento": {
        "type": "object",
        "properties": {
          "lavaRapidoId": {
            "type": "string"
          },
          "veiculoId": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "observacao": {
            "type": "string"
          }
        },
        "required": [
          "lavaRapidoId",
          "veiculoId",
          "data"
        ]
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Login do usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso"
          },
          "400": {
            "description": "Credenciais inválidas"
          }
        }
      }
    },
    "/user/register": {
      "post": {
        "tags": [
          "Usuário"
        ],
        "summary": "Criar um novo usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado com sucesso"
          },
          "400": {
            "description": "Erro ao criar usuário"
          }
        }
      },
      "get": {
        "tags": [
          "Usuário"
        ],
        "summary": "Listar todos os usuários",
        "responses": {
          "200": {
            "description": "Lista de usuários retornada"
          }
        }
      }
    },
    "/user/{id}": {
      "get": {
        "tags": [
          "Usuário"
        ],
        "summary": "Buscar usuário por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário encontrado"
          }
        }
      },
      "patch": {
        "tags": [
          "Usuário"
        ],
        "summary": "Atualizar usuário por ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário atualizado"
          }
        }
      }
    },
    "/veiculo/register": {
      "post": {
        "tags": [
          "Veículo"
        ],
        "summary": "Criar veículo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Veiculo"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Veículo criado"
          }
        }
      },
      "get": {
        "tags": [
          "Veículo"
        ],
        "summary": "Listar veículos com paginação",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de veículos"
          }
        }
      }
    },
    "/veiculo/top": {
      "get": {
        "tags": [
          "Veículo"
        ],
        "summary": "Buscar veículo em destaque",
        "responses": {
          "200": {
            "description": "Veículo encontrado"
          }
        }
      }
    },
    "/veiculo/search": {
      "get": {
        "tags": [
          "Veículo"
        ],
        "summary": "Buscar veículo por placa",
        "parameters": [
          {
            "name": "placa",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Veículo encontrado"
          },
          "400": {
            "description": "Veículo não encontrado"
          }
        }
      }
    },
    "/veiculo/byUser": {
      "get": {
        "tags": [
          "Veículo"
        ],
        "summary": "Listar veículos do usuário autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de veículos do usuário"
          }
        }
      }
    },
    "/veiculo/{id}": {
      "get": {
        "tags": [
          "Veículo"
        ],
        "summary": "Buscar veículo por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Veículo encontrado"
          }
        }
      },
      "patch": {
        "tags": [
          "Veículo"
        ],
        "summary": "Atualizar veículo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Veiculo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Veículo atualizado com sucesso"
          }
        }
      },
      "delete": {
        "tags": [
          "Veículo"
        ],
        "summary": "Deletar veículo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Veículo deletado com sucesso"
          }
        }
      }
    },
    "/customer/register": {
      "post": {
        "tags": [
          "Customers"
        ],
        "summary": "Criar cliente",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Customer"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cliente criado com sucesso"
          },
          "400": {
            "description": "Erro ao criar cliente"
          }
        }
      },
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Listar clientes com paginação e busca",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de clientes"
          }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "tags": [
          "Customers"
        ],
        "summary": "Buscar cliente por ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cliente encontrado"
          },
          "404": {
            "description": "Cliente não encontrado"
          }
        }
      },
      "patch": {
        "tags": [
          "Customers"
        ],
        "summary": "Atualizar cliente",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Customer"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cliente atualizado com sucesso"
          }
        }
      },
      "delete": {
        "tags": [
          "Customers"
        ],
        "summary": "Deletar cliente",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cliente deletado com sucesso"
          }
        }
      }
    },
    "/customers/nearby": {
      "get": {
        "tags": [
          "Lava Rápidos"
        ],
        "summary": "Listar lava rápidos próximos (geolocalização)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "maxDistance",
            "in": "query",
            "schema": {
              "type": "number",
              "description": "Raio em metros (padrão 10000)"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de lava rápidos ordenada por distância (distance em km)"
          }
        }
      }
    },
    "/customers/public/{id}": {
      "get": {
        "tags": [
          "Lava Rápidos"
        ],
        "summary": "Detalhes públicos de um lava rápido",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalhes do lava rápido"
          },
          "404": {
            "description": "Lava rápido não encontrado"
          }
        }
      }
    },
    "/veiculo-cliente/register": {
      "post": {
        "tags": [
          "Veículos do Cliente"
        ],
        "summary": "Cadastrar veículo do consumidor",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VeiculoCliente"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Veículo cadastrado"
          },
          "409": {
            "description": "Placa já cadastrada"
          }
        }
      }
    },
    "/veiculo-cliente": {
      "get": {
        "tags": [
          "Veículos do Cliente"
        ],
        "summary": "Listar veículos do consumidor logado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de veículos"
          }
        }
      }
    },
    "/veiculo-cliente/{id}": {
      "get": {
        "tags": [
          "Veículos do Cliente"
        ],
        "summary": "Buscar veículo do consumidor por ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Veículo encontrado"
          }
        }
      },
      "patch": {
        "tags": [
          "Veículos do Cliente"
        ],
        "summary": "Atualizar veículo do consumidor",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VeiculoCliente"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Veículo atualizado"
          }
        }
      },
      "delete": {
        "tags": [
          "Veículos do Cliente"
        ],
        "summary": "Remover veículo do consumidor",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Veículo removido"
          }
        }
      }
    },
    "/agendamentos/register": {
      "post": {
        "tags": [
          "Agendamentos"
        ],
        "summary": "Criar agendamento (o veículo entra automaticamente na fila do lava rápido)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Agendamento"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Agendamento criado"
          },
          "400": {
            "description": "Lava rápido inativo ou veículo inválido"
          }
        }
      }
    },
    "/agendamentos/dashboard": {
      "get": {
        "tags": [
          "Agendamentos"
        ],
        "summary": "Agendamentos do lava rápido do dono logado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "agendado",
                "confirmado",
                "concluido",
                "cancelado"
              ]
            }
          },
          {
            "name": "inicio",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "fim",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de agendamentos do lava rápido"
          }
        }
      }
    },
    "/agendamentos/meus": {
      "get": {
        "tags": [
          "Agendamentos"
        ],
        "summary": "Agendamentos do consumidor logado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de agendamentos do consumidor"
          }
        }
      }
    },
    "/agendamentos/{id}": {
      "get": {
        "tags": [
          "Agendamentos"
        ],
        "summary": "Buscar agendamento por ID (dono do lava rápido ou consumidor)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agendamento encontrado"
          }
        }
      },
      "patch": {
        "tags": [
          "Agendamentos"
        ],
        "summary": "Atualizar status do agendamento (agendado, confirmado, concluido, cancelado)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "agendado",
                      "confirmado",
                      "concluido",
                      "cancelado"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agendamento atualizado"
          }
